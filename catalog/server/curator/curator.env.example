# Настройки куратора. Скопировать в /etc/artcatalog-curator.env,
# вписать ключ и закрыть от чужих глаз:
#   sudo chmod 600 /etc/artcatalog-curator.env
# Этот файл с настоящим ключом — только на сервере. Никуда его не пересылайте.

# «Ключ авторизации» из личного кабинета GigaChat (длинная строка Base64)
GIGACHAT_KEY=

# физлицо (тариф Freemium) — GIGACHAT_API_PERS; юрлицо — GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# модель: GigaChat-3-Ultra — самая сильная в API; какие доступны ключу — покажет --check
GIGACHAT_MODEL=GigaChat-3-Ultra

# корневой сертификат НУЦ Минцифры (скачивается в шаге 2 инструкции)
GIGACHAT_CA=/etc/ssl/certs/russian_trusted_root_ca.pem

# папка статики каталога на этом сервере
CURATOR_STATIC=/home/develop/donexpo/static/artcatalog

# адреса страниц, где стоит каталог (через запятую, без пробелов и / в конце)
CURATOR_ORIGINS=https://monthly-delicious-mirror.tilda.ws,https://xn----7sbh1cajbjfe.xn--p1ai,https://www.xn----7sbh1cajbjfe.xn--p1ai

# голос ответов — Яндекс SpeechKit: секретный API-ключ сервисного аккаунта
# (роль ai.speechkit-tts.user). Пусто — ответы озвучивает устройство посетителя
YANDEX_TTS_KEY=
YANDEX_TTS_VOICE=vera
YANDEX_TTS_ROLE=casual
YANDEX_TTS_MODEL=livetts
# mp3, которые столько дней никто не слушал, удаляются (папка не растёт без конца)
YANDEX_TTS_KEEP_DAYS=30

# имя куратора — так она представляется
CURATOR_NAME=Татьяна

# где слушать: только сам сервер, снаружи — через nginx
CURATOR_HOST=127.0.0.1
CURATOR_PORT=8765

# ограничения: вопросов с одного адреса в час и к нейросети в сутки на весь сайт
CURATOR_RATE=20
CURATOR_WINDOW=3600
CURATOR_DAILY=3000
