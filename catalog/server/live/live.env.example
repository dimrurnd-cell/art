# Настройки онлайн-режима. Скопировать в /etc/artcatalog-live.env, права 600:
#   sudo cp live.env.example /etc/artcatalog-live.env && sudo chmod 600 /etc/artcatalog-live.env
# Пароль модератора — только здесь, никому не пересылать.

# пароль страницы модератора https://donexpocentre.ru/api/artcatalog/live/admin (не короче 10 символов)
LIVE_ADMIN_PASSWORD=

# сайты, с которых можно подключаться (через запятую)
LIVE_ORIGINS=https://monthly-delicious-mirror.tilda.ws,https://xn----7sbh1cajbjfe.xn--p1ai,https://www.xn----7sbh1cajbjfe.xn--p1ai,https://donexpocentre.ru

# база с перепиской (папка создаётся сама, у пользователя службы)
LIVE_DB=/home/develop/.local/share/artcatalog-live/live.db

# где слушать — nginx передаёт сюда
LIVE_HOST=127.0.0.1
LIVE_PORT=8767

# ограничения
LIVE_PER_IP=8
LIVE_MSG_RATE=10
LIVE_INVITE_RATE=5
# новых посетителей (первый вход с нового устройства) с одного адреса в час
LIVE_NEW_PER_IP=20

# сроки хранения, дней (как в политике обработки персональных данных; для
# организатора распространения информации — 149-ФЗ ст. 10.1): текст сообщений —
# 6 месяцев, сведения о посетителях и фактах переписки — 3 года; старее удаляется само
LIVE_KEEP_MSG_DAYS=180
LIVE_KEEP_VISITOR_DAYS=1095
