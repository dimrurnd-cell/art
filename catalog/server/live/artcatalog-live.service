# Служба онлайн-режима. Скопировать в /etc/systemd/system/artcatalog-live.service,
# в строке User= — владелец папки статики (как у куратора), затем:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now artcatalog-live
[Unit]
Description=Онлайн-режим выставки Арт-Ростов (посетители и разговоры)
After=network-online.target
Wants=network-online.target

[Service]
User=develop
EnvironmentFile=/etc/artcatalog-live.env
ExecStart=/usr/bin/python3.6 /opt/artcatalog-live/live_server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
# Защита — только то, что понимает systemd 219 (CentOS 7).
# Новые файлы (база, её журнал) — только владельцу службы:
UMask=0077
# /usr, /boot, /etc — только чтение; из устройств — лишь /dev/null, /dev/urandom и т. п.:
ProtectSystem=full
PrivateDevices=true
CapabilityBoundingSet=
# Статика сайта — только чтение: служба работает от её владельца, но менять файлы
# сайта не может. «-» — не мешать запуску, если папки нет. Своя база
# (~/.local/share/artcatalog-live) остаётся доступной для записи.
ReadOnlyDirectories=-/home/develop/donexpo

[Install]
WantedBy=multi-user.target
